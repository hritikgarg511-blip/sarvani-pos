# DATABASE_URL="postgresql://user:password@host:5432/sarvani_pos?schema=public"

# === Auth ===
JWT_SECRET="change_this_to_a_long_random_string_in_production"
JWT_EXPIRES_IN="12h"

# === Business Info ===
BUSINESS_NAME="Sarvani Suit and Saree"
BUSINESS_GSTIN="08BWCPG8379P1ZO"
BUSINESS_STATE_CODE="08"
BUSINESS_UPI_ID="7976900021@pthdfc"
BUSINESS_WHATSAPP_NUMBER="7976900021"

# === WhatsApp Cloud API (fill in when you have Meta credentials) ===
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
